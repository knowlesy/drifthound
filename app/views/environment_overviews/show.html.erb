<div class="environment-detail">
  <header class="project-header">
    <div class="breadcrumb" title="<%= @key %>">
      <%= link_to "DriftHound", root_path %><span class="breadcrumb-sep"> › </span><span title="<%= @key %>"><%= @key %></span>
    </div>
    <%= link_to "← Back to dashboard", root_path, class: "back-link" %>
  </header>

  <section class="project-summary-card">
    <div class="summary-top">
      <div class="main-info">
        <h1 title="<%= @key %>"><%= @key %></h1>
        <span class="status-pill status-pill--<%= @rollup.worst_status %>"><%= @rollup.worst_status.upcase %></span>
      </div>
      <div>
        <span class="last-check-time"><%= project_label_count(@rollup.layers.size) %></span>
      </div>
    </div>
    <div class="rollup-summary">
      <span class="rollup-summary-item" title="<%= project_label(plural: true) %> by status">
        <% @rollup.status_counts.each do |status, count| %>
          <% next if status == "unknown" && count.zero? %>
          <span class="rollup-count rollup-count--<%= status %>" data-status="<%= status %>"><%= count %> <%= status == "ok" ? "OK" : status.capitalize %></span>
        <% end %>
      </span>
      <span class="rollup-summary-item rollup-totals">Add / Change / Destroy: <%= @rollup.add_total %> / <%= @rollup.change_total %> / <%= @rollup.destroy_total %></span>
      <span class="rollup-summary-item rollup-last-check">
        Last check:
        <% if @rollup.last_checked_at %>
          <%= time_ago_in_words(@rollup.last_checked_at) %> ago
        <% else %>
          Never
        <% end %>
      </span>
    </div>
  </section>

  <section class="projects-list">
    <div class="projects-table environment-overview-table">
      <div class="project-envs-header">
        <span><%= project_label %></span>
        <span>Environment</span>
        <span>Status</span>
        <span>Add / Change / Destroy</span>
        <span style="text-align:right;">Last Check</span>
      </div>
      <% @rollup.layers.each do |layer| %>
        <% environment = layer.environment %>
        <% check = layer.latest_check %>
        <% status = layer.status %>
        <div class="project-env-row project-row--<%= status %>">
          <span class="col-project" title="<%= layer.project.name %>">
            <%= link_to layer.project.name, project_environment_path(layer.project.key, environment.key) %>
          </span>
          <span class="col-environment" title="<%= environment.name %>">
            <%= environment.name %>
            <% if layer.excluded? %>
              <span class="badge badge-info" title="Left out of the dashboard charts and stability score">Excluded from metrics</span>
            <% end %>
          </span>
          <span class="col-status">
            <span class="status-indicator status-indicator--<%= status %>"></span>
            <span class="status-text status-text--<%= status %>"><%= status.upcase %></span>
          </span>
          <span class="col-counts">
            <% if check %>
              <%= layer.add_count %> / <%= layer.change_count %> / <%= layer.destroy_count %>
            <% else %>
              —
            <% end %>
          </span>
          <span class="col-time" style="text-align:right;">
            <% if layer.last_checked_at %>
              <%= time_ago_in_words(layer.last_checked_at) %> ago
            <% else %>
              Never
            <% end %>
          </span>
        </div>
      <% end %>
    </div>
  </section>
</div>
