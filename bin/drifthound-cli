#!/usr/bin/env ruby
# frozen_string_literal: true
# encoding: utf-8

# drifthound-cli: Run Terraform/Terragrunt/OpenTofu, parse drift, and send to DriftHound API
#
# Usage: drifthound-cli --tool=terraform --project=my-project --token=XXX --api-url=... [--dir=DIR] [--repository=URL] [--branch=BRANCH]
# Example: drifthound-cli --tool=terraform --project=my-project --token=XXX --api-url=http://localhost:3000 --dir=infra --repository=https://github.com/org/repo --branch=master
# Note: Repository URL and branch are auto-detected from git if not provided
#
# This file is installed on its own (curl, Docker image), so it must stay a
# single self-contained script that only uses the Ruby standard library.
require 'json'
require 'net/http'
require 'open3'
require 'optparse'
require 'set'
require 'uri'

module DriftHoundCli
  # Raised for bad command-line input; main prints the message and exits 1.
  class UsageError < StandardError; end

  # Every shell-out goes through a runner so tests can replace it.
  # A runner is callable(cmd_array, chdir: nil, merge_stderr: false) -> [stdout, stderr, status]
  # where status responds to success? and exitstatus. Commands are arrays, so
  # no shell is involved. With merge_stderr the two streams come back
  # interleaved as one string in the first slot, and stderr is "".
  DEFAULT_RUNNER = lambda do |cmd, chdir: nil, merge_stderr: false|
    popen_opts = chdir ? { chdir: chdir } : {}
    if merge_stderr
      combined, status = Open3.capture2e(*cmd, **popen_opts)
      [ combined, '', status ]
    else
      Open3.capture3(*cmd, **popen_opts)
    end
  end

  MAX_UNMANAGED_RESOURCES = 5000

  module Text
    # Command output is untrusted bytes; make it valid UTF-8 before it is sent as JSON
    def self.clean(text)
      text.to_s.dup.force_encoding('UTF-8').scrub('?')
    end
  end

  module Unmanaged
    # Returns [items, dropped_count]
    def self.truncate(items, max: MAX_UNMANAGED_RESOURCES)
      return [ items, 0 ] if items.size <= max

      [ items.first(max), items.size - max ]
    end
  end

  module Git
    # Remove credentials from repository URLs to prevent token leakage
    # Transforms: https://user:token@github.com/org/repo -> https://github.com/org/repo
    def self.sanitize_repository_url(url)
      return url if url.nil? || url.empty?

      url.gsub(%r{://[^@]+@}, '://')
    end

    # Auto-detect repository URL from git if not provided
    def self.detect_repository(dir, runner)
      out, _err, status = runner.call([ 'git', '-C', dir, 'remote', 'get-url', 'origin' ])
      git_url = status.success? ? out.to_s.strip : ''
      return nil if git_url.empty?

      # Convert SSH URLs to HTTPS
      # git@github.com:org/repo.git -> https://github.com/org/repo
      # ssh://git@github.com/org/repo.git -> https://github.com/org/repo
      if git_url =~ /^git@([^:]+):(.+)$/
        git_url = "https://#{$1}/#{$2}"
      elsif git_url.start_with?('ssh://git@')
        git_url = git_url.sub('ssh://git@', 'https://')
      end

      # Remove .git suffix and sanitize credentials
      git_url = git_url.sub(/\.git$/, '')
      sanitize_repository_url(git_url)
    rescue StandardError
      nil
    end

    # Auto-detect branch from git if not provided
    def self.detect_branch(dir, runner)
      out, _err, status = runner.call([ 'git', '-C', dir, 'rev-parse', '--abbrev-ref', 'HEAD' ])
      branch = status.success? ? out.to_s.strip : ''
      return nil if branch.empty? || branch == 'HEAD'

      branch
    rescue StandardError
      nil
    end

    # Fills opts[:repository] and opts[:branch] from git when they were not given
    def self.autodetect!(opts, dir, runner)
      if opts[:repository]
        # Sanitize manually provided repository URL
        opts[:repository] = sanitize_repository_url(opts[:repository])
      else
        detected_repo = detect_repository(dir, runner)
        if detected_repo
          opts[:repository] = detected_repo
          puts "Auto-detected repository: #{detected_repo}"
        end
      end

      return if opts[:branch]

      detected_branch = detect_branch(dir, runner)
      return unless detected_branch

      opts[:branch] = detected_branch
      puts "Auto-detected branch: #{detected_branch}"
    end
  end

  module Reporter
    # Adds the fields every mode shares, sends the report and returns the exit code
    def self.post(opts, payload)
      payload = payload.dup

      # Add repository if provided
      payload[:repository] = opts[:repository] if opts[:repository]

      # Add branch if provided
      payload[:branch] = opts[:branch] if opts[:branch]

      payload[:environment_name] = opts[:environment_name] if opts[:environment_name]

      # Add notification channel configuration if provided
      if opts[:slack_channel]
        payload[:notification_channel] = {
          channel_type: 'slack',
          enabled: true,
          config: {
            channel: opts[:slack_channel]
          }
        }
      end

      puts 'Building API request...'
      uri = URI("#{opts[:api_url]}/api/v1/projects/#{opts[:project]}/environments/#{opts[:environment]}/checks")
      puts "Sending drift report to #{uri}..."
      $stdout.flush

      begin
        req = Net::HTTP::Post.new(uri)
        req['Authorization'] = "Bearer #{opts[:token]}"
        req['Content-Type'] = 'application/json'
        req.body = payload.to_json

        res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == 'https') { |http| http.request(req) }
        puts "Response: #{res.code} #{res.body}"
      rescue StandardError => e
        puts "Error sending API request: #{e.class} - #{e.message}"
        return 1
      end

      res.code.to_i >= 400 ? 1 : 0
    end
  end

  module Modes
    # terraform, terragrunt and opentofu: run a plan and report its drift
    class Plan
      def self.add_options(_parser, _opts); end

      def initialize(opts, runner: DEFAULT_RUNNER)
        @opts = opts
        @runner = runner
      end

      def build_payload
        dir = @opts[:dir] || Dir.pwd
        cmd = [ @opts[:tool], 'plan', '-no-color', '-detailed-exitcode', '-lock=false' ]

        puts "Running: #{cmd.join(' ')} in #{dir}"
        start_time = Time.now
        begin
          stdout, stderr, run_status = @runner.call(cmd, chdir: dir, merge_stderr: true)
          output = Text.clean("#{stdout}#{stderr}")
          exit_code = run_status.exitstatus
        rescue StandardError => e
          puts "Error running command: #{e.message}"
          output = "Error: #{e.message}"
          exit_code = 1
        end
        duration = Time.now - start_time
        puts output
        puts "Command exit code: #{exit_code}"
        $stdout.flush

        # Determine status from -detailed-exitcode
        # Exit code 0 = no changes, 1 = error, 2 = changes detected (drift)
        status =
          case exit_code
          when 0 then 'ok'
          when 2 then 'drift'
          else 'error'
          end
        puts "Determined status: #{status}"

        add_count = output[/ (\d+) to add/, 1]&.to_i || 0
        change_count = output[/ (\d+) to change/, 1]&.to_i || 0
        destroy_count = output[/ (\d+) to destroy/, 1]&.to_i || 0
        puts "Counts - add: #{add_count}, change: #{change_count}, destroy: #{destroy_count}"

        {
          source: 'terraform',
          status: status,
          add_count: add_count,
          change_count: change_count,
          destroy_count: destroy_count,
          duration: duration,
          raw_output: output,
          directory: dir
        }
      end
    end
  end

  # Reads the resources Terraform manages out of state JSON. Both layouts are
  # supported: `terraform show -json` (values.root_module with child_modules)
  # and raw state v4 as printed by `terraform state pull` (resources[].instances[]).
  # Only the "id" attribute of managed resources is used, and only when it is an
  # ARM ID. Composite ids and other *_id attributes are not split or scanned:
  # that would wrongly mark unrelated resources as managed.
  module TerraformState
    ARM_ID = %r{\A/subscriptions/}i.freeze

    def self.normalize(id)
      id.strip.chomp('/').downcase
    end

    def self.managed_ids(state)
      ids = []
      return ids unless state.is_a?(Hash)

      walk_module(state.dig('values', 'root_module'), ids) if state['values'].is_a?(Hash)
      collect_state_resources(state['resources'], ids) if state['resources'].is_a?(Array)
      ids.uniq
    end

    def self.walk_module(mod, ids)
      return unless mod.is_a?(Hash)

      Array(mod['resources']).each do |resource|
        next unless resource.is_a?(Hash) && resource['mode'] == 'managed'

        add_id(resource['values'], ids)
      end
      Array(mod['child_modules']).each { |child| walk_module(child, ids) }
    end

    def self.collect_state_resources(resources, ids)
      resources.each do |resource|
        next unless resource.is_a?(Hash) && resource['mode'] == 'managed'

        Array(resource['instances']).each do |instance|
          add_id(instance['attributes'], ids) if instance.is_a?(Hash)
        end
      end
    end

    def self.add_id(attributes, ids)
      return unless attributes.is_a?(Hash)

      id = attributes['id']
      ids << normalize(id) if id.is_a?(String) && id.strip =~ ARM_ID
    end
  end

  # Finds resources that exist in Azure but are not in Terraform state.
  # Collection and diffing both happen here, so the server never receives
  # credentials or state, only the unmanaged items.
  class AzureError < StandardError; end

  module Modes
    class AzureUnmanaged
      QUERY = "resources | union (resourcecontainers | where type =~ 'microsoft.resources/subscriptions/resourcegroups') " \
              '| project id, name, type, location, resourceGroup, subscriptionId, managedBy, tags | order by id asc'
      SUBSCRIPTIONS_QUERY = "resourcecontainers | where type =~ 'microsoft.resources/subscriptions' | project subscriptionId"
      PAGE_SIZE = 1000
      MAX_PAGES = 2000
      STATE_TOOLS = %w[terraform tofu terragrunt].freeze
      MAX_STDERR = 4000
      MAX_LISTED = 200
      TAGS_LIMIT_BYTES = 1800
      FIELD_LIMITS = { resource_type: 255, name: 255, scope: 255, location: 128 }.freeze
      IDENTIFIER_LIMIT = 1024
      RESOURCE_GROUP_ID = %r{\A(/subscriptions/[^/]+/resourcegroups/[^/]+)}i.freeze

      def self.add_options(parser, opts)
        parser.on('--subscription=ID', 'Azure subscription ID to scan (repeatable, azure tool)') { |v| (opts[:subscriptions] ||= []) << v }
        parser.on('--state-dir=DIR', 'Directory to run `<state-tool> state pull` in (repeatable, azure tool)') { |v| (opts[:state_dirs] ||= []) << v }
        parser.on('--state-file=FILE', 'Terraform state or `show -json` file (repeatable, azure tool)') { |v| (opts[:state_files] ||= []) << v }
        parser.on('--state-tool=TOOL', STATE_TOOLS.join('|') + ' (default terraform, azure tool)') { |v| opts[:state_tool] = v }
        parser.on('--include-managed-by', 'Also report resources owned by another service via managedBy (azure tool)') { opts[:include_managed_by] = true }
      end

      def initialize(opts, runner: DEFAULT_RUNNER)
        @opts = opts
        @runner = runner
        @subscriptions = Array(opts[:subscriptions]).map(&:strip).reject(&:empty?).uniq
        @state_dirs = Array(opts[:state_dirs])
        @state_files = Array(opts[:state_files])
        @state_tool = opts[:state_tool] || 'terraform'

        raise UsageError, 'Missing --subscription (at least one is required for --tool=azure)' if @subscriptions.empty?
        raise UsageError, 'Missing --state-dir or --state-file (at least one is required for --tool=azure)' if @state_dirs.empty? && @state_files.empty?
        raise UsageError, "Unknown --state-tool (use #{STATE_TOOLS.join(', ')})" unless STATE_TOOLS.include?(@state_tool)
      end

      def build_payload
        start_time = Time.now
        begin
          items, summary = collect
          status = 'ok'
        rescue AzureError => e
          items = nil
          status = 'error'
          summary = "Azure unmanaged resource check failed: #{e.message}"
        rescue StandardError => e
          items = nil
          status = 'error'
          summary = "Azure unmanaged resource check failed: unexpected #{e.class}: #{e.message}"
        end
        puts summary
        puts "Determined status: #{status}"
        $stdout.flush

        payload = {
          source: 'azure',
          status: status,
          duration: Time.now - start_time,
          raw_output: Text.clean(summary)
        }
        payload[:directory] = @opts[:dir] if @opts[:dir]
        payload[:unmanaged_resources] = items if items
        payload
      end

      private

      # Returns [unmanaged_items, summary_text]; raises AzureError on any failure
      def collect
        managed = read_state_sources
        raise AzureError, 'no managed resource IDs were found in the state sources (is the state initialised and the right directory used?)' if managed.empty?

        verify_subscriptions
        rows = query_graph(QUERY)
        unmanaged, skipped_managed_by, skipped_long = diff(rows, managed)
        unmanaged.sort_by! { |item| item[:identifier].downcase }
        items, dropped = Unmanaged.truncate(unmanaged, max: MAX_UNMANAGED_RESOURCES)

        [ items, summary(rows.size, managed.size, skipped_managed_by, skipped_long, unmanaged.size, items, dropped) ]
      end

      # Every state source must be readable: a partial set would make
      # everything look unmanaged and raise a false drift alarm.
      def read_state_sources
        managed = Set.new
        @state_dirs.each do |dir|
          out, err, status = @runner.call([ @state_tool, 'state', 'pull' ], chdir: dir)
          raise AzureError, "#{@state_tool} state pull failed in #{dir} (exit #{status.exitstatus}): #{clip(err)}" unless status.success?

          managed.merge(parse_state(out, "state pulled from #{dir}"))
        end
        @state_files.each do |file|
          begin
            text = File.read(file)
          rescue SystemCallError => e
            raise AzureError, "cannot read state file #{file}: #{e.class}"
          end
          managed.merge(parse_state(text, "state file #{file}"))
        end
        managed
      end

      # The parser error is not reported: it would quote part of the state, which can hold secrets
      def parse_state(text, label)
        TerraformState.managed_ids(JSON.parse(text.to_s))
      rescue JSON::ParserError
        raise AzureError, "#{label} is not valid JSON"
      end

      def verify_subscriptions
        found = query_graph(SUBSCRIPTIONS_QUERY).map { |row| row['subscriptionId'].to_s.downcase }
        missing = @subscriptions.reject { |sub| found.include?(sub.downcase) }
        return if missing.empty?

        raise AzureError, "subscription(s) not visible to Resource Graph (check the identity's Reader access): #{missing.join(', ')}"
      end

      # Pages through `az graph query` until there is no skip token
      def query_graph(query)
        rows = []
        token = nil
        total = nil
        MAX_PAGES.times do
          cmd = [ 'az', 'graph', 'query', '-q', query, '--first', PAGE_SIZE.to_s, '--subscriptions', *@subscriptions, '--output', 'json' ]
          cmd += [ '--skip-token', token ] if token
          out, err, status = @runner.call(cmd)
          raise AzureError, "az graph query failed (exit #{status.exitstatus}): #{clip(err)}" unless status.success?

          page_rows, next_token = parse_page(out)
          rows.concat(page_rows)
          total = page_total(out) || total
          if next_token.nil?
            if total && rows.size < total
              raise AzureError, "az graph query returned #{rows.size} rows but reported #{total} total records; refusing to compare an incomplete inventory"
            end
            return rows
          end
          raise AzureError, 'az graph query returned the same skip token twice' if next_token == token

          token = next_token
        end
        raise AzureError, "az graph query returned more than #{MAX_PAGES} pages"
      end

      def page_total(text)
        body = JSON.parse(text.to_s)
        value = body.is_a?(Hash) ? body['total_records'] : nil
        value.is_a?(Integer) ? value : nil
      end

      # `az graph query` prints a Hash with data and skip_token; a bare array is also accepted
      def parse_page(text)
        body = JSON.parse(text.to_s)
        if body.is_a?(Hash)
          rows = body['data']
          token = body['skip_token'] || body['skipToken'] || body['$skipToken']
        else
          rows = body
          token = nil
        end
        raise AzureError, 'az graph query returned an unexpected JSON shape' unless rows.is_a?(Array) && rows.all? { |row| row.is_a?(Hash) }

        [ rows, token.to_s.strip.empty? ? nil : token.to_s ]
      rescue JSON::ParserError
        raise AzureError, 'az graph query did not return valid JSON'
      end

      # Returns [unmanaged_items, skipped_managed_by_count, skipped_too_long_count]
      def diff(rows, managed)
        managed_groups = Set.new
        unless @opts[:include_managed_by]
          rows.each do |row|
            next unless row['id'].is_a?(String) && row['type'].to_s.downcase == 'microsoft.resources/subscriptions/resourcegroups'

            managed_groups << TerraformState.normalize(row['id']) if owned?(row)
          end
        end

        items = []
        skipped_managed_by = 0
        skipped_long = 0
        rows.each do |row|
          id = row['id']
          next unless id.is_a?(String) && !id.strip.empty?

          normalized = TerraformState.normalize(id)
          next if managed.include?(normalized)

          unless @opts[:include_managed_by]
            group = normalized[RESOURCE_GROUP_ID, 1]
            if owned?(row) || (group && managed_groups.include?(group))
              skipped_managed_by += 1
              next
            end
          end
          if id.length > IDENTIFIER_LIMIT
            skipped_long += 1
            next
          end

          items << to_item(row, id)
        end
        [ items, skipped_managed_by, skipped_long ]
      end

      def owned?(row)
        !row['managedBy'].to_s.strip.empty?
      end

      def to_item(row, id)
        metadata = { subscription_id: row['subscriptionId'], managed_by: row['managedBy'], tags: row['tags'] }
        if metadata.to_json.bytesize > TAGS_LIMIT_BYTES
          metadata = { subscription_id: row['subscriptionId'], managed_by: row['managedBy'], tags_truncated: true }
        end
        {
          identifier: id.strip,
          resource_type: limit(row['type'], :resource_type),
          name: limit(row['name'], :name),
          scope: limit(row['resourceGroup'], :scope),
          location: limit(row['location'], :location),
          metadata: metadata
        }
      end

      def limit(value, field)
        return nil if value.nil?

        value.to_s[0, FIELD_LIMITS.fetch(field)]
      end

      def summary(row_count, managed_count, skipped_managed_by, skipped_long, unmanaged_total, items, dropped)
        lines = []
        lines << "Subscriptions: #{@subscriptions.join(', ')}"
        lines << "Resource Graph rows: #{row_count}"
        lines << "Managed resource IDs: #{managed_count} from #{@state_dirs.size + @state_files.size} state source(s)"
        lines << "Skipped (managedBy or managed resource group): #{skipped_managed_by}" unless @opts[:include_managed_by]
        lines << "Skipped (identifier longer than #{IDENTIFIER_LIMIT} characters): #{skipped_long}" if skipped_long.positive?
        lines << "Unmanaged resources: #{unmanaged_total}"
        lines << "Only the first #{MAX_UNMANAGED_RESOURCES} are reported; #{dropped} more were dropped." if dropped.positive?
        listed = items.first(MAX_LISTED)
        unless listed.empty?
          lines << ''
          listed.each { |item| lines << item[:identifier] }
          lines << "... and #{items.size - listed.size} more" if items.size > listed.size
        end
        lines.join("\n")
      end

      def clip(text)
        Text.clean(text.to_s.strip)[0, MAX_STDERR]
      end
    end
  end

  # Finds Kubernetes objects that no Argo CD Application owns. kubectl lists
  # every kind with a fixed jsonpath projection (never -o json), so secret
  # data and whole annotations such as last-applied-configuration are never
  # read. Ownership is decided here, so the server only sees unowned roots.
  class ArgoError < StandardError; end

  module Argo
    MAX_STDERR = 4000
    DEFAULT_INSTANCE_LABEL = 'app.kubernetes.io/instance'
    TRACKING_METHODS = %w[annotation label annotation+label].freeze

    # Kinds that are never listed: always owned, or churn that Argo CD itself excludes.
    # The names are in `kubectl api-resources -o name` form.
    KIND_DENYLIST = %w[
      events events.events.k8s.io
      endpoints endpointslices.discovery.k8s.io
      leases.coordination.k8s.io
      nodes componentstatuses bindings
      certificatesigningrequests.certificates.k8s.io
      controllerrevisions.apps
      apiservices.apiregistration.k8s.io
      flowschemas.flowcontrol.apiserver.k8s.io prioritylevelconfigurations.flowcontrol.apiserver.k8s.io
      csinodes.storage.k8s.io volumeattachments.storage.k8s.io
      tokenreviews.authentication.k8s.io selfsubjectreviews.authentication.k8s.io
      subjectaccessreviews.authorization.k8s.io selfsubjectaccessreviews.authorization.k8s.io
      selfsubjectrulesreviews.authorization.k8s.io localsubjectaccessreviews.authorization.k8s.io
      policyreports.wgpolicyk8s.io clusterpolicyreports.wgpolicyk8s.io
      ephemeralreports.reports.kyverno.io clusterephemeralreports.reports.kyverno.io
      admissionreports.kyverno.io clusteradmissionreports.kyverno.io
      backgroundscanreports.kyverno.io clusterbackgroundscanreports.kyverno.io
      updaterequests.kyverno.io
      ciliumidentities.cilium.io ciliumendpoints.cilium.io ciliumendpointslices.cilium.io ciliumnodes.cilium.io
      certificaterequests.cert-manager.io
    ].freeze
    SECRETS = 'secrets'

    # API groups that are never listed. A discovery failure that names only these groups is tolerated.
    GROUP_DENYLIST = %w[metrics.k8s.io custom.metrics.k8s.io external.metrics.k8s.io events.k8s.io].freeze

    # One entry per output column: the KubeObject member and its jsonpath.
    # The instance label path is filled in from --instance-label-key.
    COLUMNS = [
      [ :api_version, '.apiVersion' ],
      [ :kind, '.kind' ],
      [ :namespace, '.metadata.namespace' ],
      [ :name, '.metadata.name' ],
      [ :uid, '.metadata.uid' ],
      [ :created_at, '.metadata.creationTimestamp' ],
      [ :owner_refs, '.metadata.ownerReferences[*].uid' ],
      [ :tracking_id, '.metadata.annotations.argocd\.argoproj\.io/tracking-id' ],
      [ :installation_id, '.metadata.annotations.argocd\.argoproj\.io/installation-id' ],
      [ :helm_release, '.metadata.annotations.meta\.helm\.sh/release-name' ],
      [ :helm_release_ns, '.metadata.annotations.meta\.helm\.sh/release-namespace' ],
      [ :provisioned_by, '.metadata.annotations.pv\.kubernetes\.io/provisioned-by' ],
      [ :instance_label, nil ],
      [ :managed_by, '.metadata.labels.app\.kubernetes\.io/managed-by' ],
      [ :app_name, '.metadata.labels.app\.kubernetes\.io/name' ],
      [ :part_of, '.metadata.labels.app\.kubernetes\.io/part-of' ],
      [ :helm_chart, '.metadata.labels.helm\.sh/chart' ],
      [ :aks_managedby, '.metadata.labels.kubernetes\.azure\.com/managedby' ],
      [ :addon_mode, '.metadata.labels.addonmanager\.kubernetes\.io/mode' ],
      [ :bootstrapping, '.metadata.labels.kubernetes\.io/bootstrapping' ],
      [ :vct_names, '.spec.volumeClaimTemplates[*].metadata.name' ],
      [ :claim_ns, '.spec.claimRef.namespace' ],
      [ :claim_name, '.spec.claimRef.name' ],
      [ :type, '.type' ]
    ].freeze
    COLUMN_COUNT = COLUMNS.size

    KubeObject = Struct.new(*COLUMNS.map(&:first), keyword_init: true) do
      def group
        api_version.include?('/') ? api_version.split('/', 2).first : ''
      end

      def owner_uids
        owner_refs.split
      end

      def cluster_scoped?
        namespace.empty?
      end

      def secret_type
        kind == 'Secret' ? type : ''
      end
    end

    # Escapes the dots in a map key, as kubectl jsonpath needs: a.b/c -> a\.b/c
    def self.jsonpath_key(key)
      key.gsub('.') { '\\.' }
    end

    def self.template(instance_label_key = DEFAULT_INSTANCE_LABEL)
      paths = COLUMNS.map do |member, path|
        member == :instance_label ? ".metadata.labels.#{jsonpath_key(instance_label_key)}" : path
      end
      '{range .items[*]}' + paths.map { |path| "{#{path}}" }.join('{"\t"}') + '{"\n"}{end}'
    end

    def self.clip(text)
      Text.clean(text.to_s.strip)[0, MAX_STDERR]
    end

    # Parses the output of `kubectl get <resource> -o jsonpath=<template>`. Anything
    # unexpected is fatal: a skipped line would silently hide a finding.
    def self.parse_lines(text, resource)
      objects = []
      text.to_s.each_line.each_with_index do |line, index|
        line = line.chomp
        next if line.strip.empty?

        columns = line.split("\t", -1)
        unless columns.size == COLUMN_COUNT
          raise ArgoError, "unexpected output from kubectl get #{resource}: line #{index + 1} has #{columns.size} columns, expected #{COLUMN_COUNT}"
        end

        object = KubeObject.new(**COLUMNS.map(&:first).zip(columns).to_h)
        raise ArgoError, "kubectl did not report kind for #{resource}" if object.kind.empty?
        raise ArgoError, "kubectl did not report a name and uid for an object of #{resource}" if object.name.empty? || object.uid.empty?

        objects << object
      end
      objects
    end

    # Runs kubectl through the runner. Selection is by flags, never by environment.
    class Kubectl
      def initialize(runner, bin: 'kubectl', kubeconfig: nil, context: nil, timeout: '120s')
        @runner = runner
        @bin = bin
        @kubeconfig = kubeconfig
        @context = context
        @timeout = timeout
      end

      def command(args, with_context: true)
        cmd = [ @bin ]
        cmd += [ '--kubeconfig', @kubeconfig ] if @kubeconfig
        cmd += [ '--context', @context ] if @context && with_context
        cmd + [ '--request-timeout', @timeout ] + args
      end

      def run(args, with_context: true)
        out, err, status = @runner.call(command(args, with_context: with_context))
        [ Text.clean(out), Text.clean(err), status ]
      rescue Errno::ENOENT
        raise ArgoError, "kubectl was not found (#{@bin}); install it or pass --kubectl=PATH"
      end

      # Returns [resource names in `api-resources -o name` form, notes]
      def discover(namespaced)
        out, err, status = run([ 'api-resources', '--verbs=list', "--namespaced=#{namespaced}", '-o', 'name' ])
        names = out.lines.map(&:strip).reject(&:empty?)
        return [ names, [] ] if status.success?

        groups = failing_groups(err)
        unless !names.empty? && !groups.empty? && (groups - GROUP_DENYLIST).empty?
          raise ArgoError, "kubectl api-resources failed (exit #{status.exitstatus}): #{Argo.clip(err)}"
        end

        [ names, [ "kubectl api-resources reported errors for #{groups.join(', ')}; those groups are not scanned" ] ]
      end

      # Only a partial-discovery error is tolerated, and only when it names groups we skip anyway
      def failing_groups(stderr)
        return [] unless stderr.include?('unable to retrieve the complete list of server APIs')

        stderr.scan(%r{([a-z0-9][a-z0-9.-]*\.[a-z0-9.-]+)/v[0-9][a-z0-9]*}).flatten.uniq
      end

      def list(resource, namespaced, chunk_size, template)
        args = [ 'get', resource ]
        args << '--all-namespaces' if namespaced
        run(args + [ '--chunk-size', chunk_size.to_s, '-o', "jsonpath=#{template}" ])
      end

      def applications
        run([ 'get', 'applications.argoproj.io', '--all-namespaces', '-o', 'json' ])
      end

      def current_context
        out, _err, status = run([ 'config', 'current-context' ], with_context: false)
        status.success? ? out.strip : nil
      end
    end

    # Lists every eligible kind, one kubectl call per kind so a failure names its kind
    class Inventory
      Fetch = Struct.new(:resource, :namespaced, :objects, :problem, :message, keyword_init: true)
      Result = Struct.new(:objects, :listed, :denied, :excluded, :gone, :notes, keyword_init: true)

      def initialize(kubectl, concurrency:, chunk_size:, instance_label_key:, include_secrets:, exclude_kinds:)
        @kubectl = kubectl
        @concurrency = concurrency
        @chunk_size = chunk_size
        @template = Argo.template(instance_label_key)
        @include_secrets = include_secrets
        @exclude_kinds = exclude_kinds
      end

      def collect
        namespaced, notes = @kubectl.discover(true)
        cluster, cluster_notes = @kubectl.discover(false)
        targets, denied, excluded = plan(namespaced.map { |n| [ n, true ] } + cluster.map { |n| [ n, false ] })
        raise ArgoError, 'kubectl api-resources returned no listable kinds' if targets.empty?

        fetches = fetch_all(targets)
        failures(fetches)
        gone = fetches.select { |f| f.problem == :gone }.map(&:resource)
        objects = fetches.flat_map(&:objects)
        raise ArgoError, 'kubectl returned no objects at all (wrong cluster or no access?)' if objects.empty?

        Result.new(objects: objects, listed: fetches.size - gone.size, denied: denied, excluded: excluded, gone: gone,
                   notes: notes + cluster_notes)
      end

      private

      # Core group first, then the other groups alphabetically, so uid de-duplication is stable
      def plan(entries)
        denied = 0
        excluded = 0
        targets = []
        entries.uniq.sort_by { |name, _| [ name.include?('.') ? 1 : 0, name ] }.each do |name, namespaced|
          group = name.split('.', 2)[1]
          if GROUP_DENYLIST.include?(group) || KIND_DENYLIST.include?(name) || (name == SECRETS && !@include_secrets)
            denied += 1
          elsif @exclude_kinds.include?(name)
            excluded += 1
          else
            targets << [ name, namespaced ]
          end
        end
        [ targets, denied, excluded ]
      end

      def fetch_all(targets)
        results = Array.new(targets.size)
        queue = Queue.new
        targets.each_with_index { |target, index| queue << [ target, index ] }
        workers = Array.new([ @concurrency, targets.size ].min) do
          Thread.new do
            Thread.current.report_on_exception = false
            while (job = next_job(queue))
              (name, namespaced), index = job
              results[index] = fetch(name, namespaced)
            end
          end
        end
        workers.each(&:value)
        results
      end

      def next_job(queue)
        queue.pop(true)
      rescue ThreadError
        nil
      end

      def fetch(name, namespaced)
        out, err, status = @kubectl.list(name, namespaced, @chunk_size, @template)
        unless status.success?
          problem = case err
                    when /forbidden/i then :forbidden
                    when /doesn't have a resource type|could not find the requested resource|\(NotFound\)/i then :gone
                    else :error
                    end
          return Fetch.new(resource: name, namespaced: namespaced, objects: [], problem: problem,
                           message: "exit #{status.exitstatus}: #{Argo.clip(err)}")
        end

        Fetch.new(resource: name, namespaced: namespaced, objects: Argo.parse_lines(out, name))
      end

      # A kind that cannot be read would silently hide findings, so every failure is fatal.
      # A kind deleted between discovery and listing is the one exception.
      def failures(fetches)
        forbidden = fetches.select { |f| f.problem == :forbidden }.map(&:resource)
        other = fetches.select { |f| f.problem == :error }
        return if forbidden.empty? && other.empty?

        parts = []
        unless forbidden.empty?
          parts << "access to #{forbidden.size} kind(s) is forbidden: #{forbidden.join(', ')}. " \
                   'Grant list access (see the RBAC section of the docs) or skip them with --exclude-kind=<resource>'
        end
        other.first(5).each { |f| parts << "kubectl get #{f.resource} failed (#{f.message})" }
        raise ArgoError, parts.join('; ')
      end
    end
  end

  module Modes
    class ArgoUnowned
      TIMEOUT_FORMAT = /\A\d+(ms|s|m|h)?\z/.freeze
      LABEL_KEY_FORMAT = %r{\A([A-Za-z0-9.-]+/)?[A-Za-z0-9_.-]{1,63}\z}.freeze
      DEFAULT_DESTINATIONS = %w[https://kubernetes.default.svc in-cluster].freeze
      CLUSTER_NAME_LIMIT = 128

      def self.add_options(parser, opts)
        parser.on('--context=NAME', 'kubectl context of the cluster to scan (argocd tool)') { |v| opts[:kube_context] = v }
        parser.on('--kubeconfig=FILE', 'kubeconfig file to use (argocd tool)') { |v| opts[:kubeconfig] = v }
        parser.on('--kubectl=PATH', 'kubectl binary (default kubectl, argocd tool)') { |v| opts[:kubectl] = v }
        parser.on('--cluster-name=NAME', 'Name stored as the location (default: the context, argocd tool)') { |v| opts[:cluster_name] = v }
        parser.on('--argocd-context=NAME', 'kubectl context where Argo CD runs, if not the scanned cluster (argocd tool)') { |v| opts[:argocd_context] = v }
        parser.on('--argocd-kubeconfig=FILE', 'kubeconfig used to read Applications (argocd tool)') { |v| opts[:argocd_kubeconfig] = v }
        parser.on('--argocd-namespace=NS', 'Namespace of an Argo CD control plane (repeatable, default argocd, argocd tool)') { |v| (opts[:argo_namespaces] ||= []) << v }
        parser.on('--argocd-destination=SERVER_OR_NAME', 'Application destination server or name that is this cluster (repeatable, argocd tool)') { |v| (opts[:argo_destinations] ||= []) << v }
        parser.on('--tracking-method=METHOD', Argo::TRACKING_METHODS.join('|') + ' (default annotation, argocd tool)') { |v| opts[:tracking_method] = v }
        parser.on('--instance-label-key=KEY', "Label Argo CD uses for the application name (default #{Argo::DEFAULT_INSTANCE_LABEL}, argocd tool)") { |v| opts[:instance_label_key] = v }
        parser.on('--argocd-installation-id=ID', 'Only count objects carrying this Argo CD installation ID (argocd tool)') { |v| opts[:argo_installation_id] = v }
        parser.on('--include-secrets', 'Also list Secrets (names and types only, argocd tool)') { opts[:include_secrets] = true }
        parser.on('--include-platform-managed', 'Also report objects managed by AKS or Kubernetes itself (argocd tool)') { opts[:include_platform_managed] = true }
        parser.on('--exclude-kind=RESOURCE', 'kubectl resource name to skip, such as foos.example.com (repeatable, argocd tool)') { |v| (opts[:exclude_kinds] ||= []) << v }
        parser.on('--chunk-size=N', Integer, 'kubectl get --chunk-size (default 500, argocd tool)') { |v| opts[:chunk_size] = v }
        parser.on('--request-timeout=DURATION', 'kubectl --request-timeout (default 120s, argocd tool)') { |v| opts[:request_timeout] = v }
        parser.on('--concurrency=N', Integer, 'Parallel kubectl calls (default 4, argocd tool)') { |v| opts[:concurrency] = v }
      end

      def initialize(opts, runner: DEFAULT_RUNNER)
        @opts = opts
        @runner = runner
        @tracking_method = opts[:tracking_method] || 'annotation'
        @instance_label_key = opts[:instance_label_key] || Argo::DEFAULT_INSTANCE_LABEL
        @argo_namespaces = clean_list(opts[:argo_namespaces])
        @argo_namespaces = [ 'argocd' ] if @argo_namespaces.empty?
        @destinations = clean_list(opts[:argo_destinations])
        @exclude_kinds = clean_list(opts[:exclude_kinds]).map(&:downcase)
        @concurrency = opts[:concurrency] || 4
        @chunk_size = opts[:chunk_size] || 500
        @timeout = opts[:request_timeout] || '120s'

        raise UsageError, "Unknown --tracking-method (use #{Argo::TRACKING_METHODS.join(', ')})" unless Argo::TRACKING_METHODS.include?(@tracking_method)
        raise UsageError, '--argocd-context needs at least one --argocd-destination, so Applications of other clusters are not mistaken for this one' if opts[:argocd_context] && @destinations.empty?
        raise UsageError, '--concurrency must be between 1 and 16' unless @concurrency.between?(1, 16)
        raise UsageError, '--chunk-size must be at least 1' unless @chunk_size >= 1
        raise UsageError, '--request-timeout must be a duration such as 120s' unless TIMEOUT_FORMAT.match?(@timeout)
        raise UsageError, '--instance-label-key is not a valid label key' unless LABEL_KEY_FORMAT.match?(@instance_label_key)
      end

      def build_payload
        start_time = Time.now
        begin
          items, summary = collect
          status = 'ok'
        rescue ArgoError => e
          items = nil
          status = 'error'
          summary = "Argo CD unowned resource check failed: #{e.message}"
        rescue StandardError => e
          items = nil
          status = 'error'
          summary = "Argo CD unowned resource check failed: unexpected #{e.class}: #{e.message}"
        end
        puts summary
        puts "Determined status: #{status}"
        $stdout.flush

        payload = {
          source: 'argocd',
          status: status,
          duration: Time.now - start_time,
          raw_output: Text.clean(summary)
        }
        payload[:directory] = @opts[:dir] if @opts[:dir]
        payload[:unmanaged_resources] = items if items
        payload
      end

      private

      def clean_list(values)
        Array(values).map { |v| v.to_s.strip }.reject(&:empty?).uniq
      end

      def kubectl
        @kubectl ||= Argo::Kubectl.new(@runner, bin: @opts[:kubectl] || 'kubectl', kubeconfig: @opts[:kubeconfig],
                                                context: @opts[:kube_context], timeout: @timeout)
      end

      def cluster_name
        name = @opts[:cluster_name] || @opts[:kube_context] || kubectl.current_context || 'in-cluster'
        name[0, CLUSTER_NAME_LIMIT]
      end

      def inventory
        Argo::Inventory.new(kubectl, concurrency: @concurrency, chunk_size: @chunk_size, instance_label_key: @instance_label_key,
                                     include_secrets: @opts[:include_secrets] ? true : false, exclude_kinds: @exclude_kinds)
      end

      # Returns [unowned_items, summary_text]; raises ArgoError on any failure
      def collect
        inventory.collect
        raise ArgoError, 'ownership analysis is not implemented yet'
      end
    end
  end

  MODES = {
    'terraform' => Modes::Plan,
    'terragrunt' => Modes::Plan,
    'opentofu' => Modes::Plan,
    'azure' => Modes::AzureUnmanaged,
    'argocd' => Modes::ArgoUnowned
  }.freeze

  def self.build_parser(opts)
    OptionParser.new do |o|
      o.on('--tool=TOOL', MODES.keys.join('|')) { |v| opts[:tool] = v }
      o.on('--project=KEY', 'Project key') { |v| opts[:project] = v }
      o.on('--environment=ENV', 'Environment key') { |v| opts[:environment] = v }
      o.on('--environment-name=NAME', 'Environment display name (defaults to the titleized key)') { |v| opts[:environment_name] = v }
      o.on('--token=TOKEN', 'API token') { |v| opts[:token] = v }
      o.on('--api-url=URL', 'API base URL') { |v| opts[:api_url] = v }
      o.on('--dir=DIR', 'Working directory') { |v| opts[:dir] = v }
      o.on('--repository=URL', 'Repository URL (auto-detected from git if not provided)') { |v| opts[:repository] = v }
      o.on('--branch=BRANCH', 'Repository branch (auto-detected from git if not provided)') { |v| opts[:branch] = v }
      o.on('--slack-channel=CHANNEL', 'Slack channel for notifications (e.g., #drift-alerts)') { |v| opts[:slack_channel] = v }
      MODES.values.uniq.each { |mode| mode.add_options(o, opts) }
    end
  end

  # Returns the process exit code
  def self.main(argv, runner: DEFAULT_RUNNER)
    opts = {}
    build_parser(opts).parse!(argv.dup)

    %i[tool project environment token api_url].each do |key|
      raise UsageError, "Missing --#{key.to_s.tr('_', '-')}" unless opts[key]
    end
    mode = MODES[opts[:tool]]
    raise UsageError, 'Unknown tool' unless mode

    check_mode = mode.new(opts, runner: runner)
    Git.autodetect!(opts, opts[:dir] || Dir.pwd, runner)
    payload = check_mode.build_payload
    Reporter.post(opts, payload)
  rescue UsageError, OptionParser::ParseError => e
    warn e.message
    1
  end
end

exit DriftHoundCli.main(ARGV) if $PROGRAM_NAME == __FILE__
